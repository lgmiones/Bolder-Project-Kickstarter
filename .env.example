# Google Tag Manager container ID, e.g. GTM-XXXXXXX
#
# GA4 is configured inside the GTM container, so GTM is the only tag this site
# loads. Do NOT add a separate GA4 measurement ID — it would double count.
#
# Leave this unset to use the default container baked into app/layout.tsx.
# Set it to "off" (or an empty string) to disable GTM entirely — do that when
# this page moves under bolderadventurepark.com, which loads its own GTM.
NEXT_PUBLIC_GTM_ID=
